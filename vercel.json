{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/index.ts", "use": "@vercel/node", "config": { "includeFiles": ["dist/**", "scripts/seeds/business-marvel-protocols.json", "context/**"], "maxDuration": 60 } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(sw\\.js|manifest\\.json|favicon\\.svg|robots\\.txt|og-default\\.jpg)$", "dest": "/$1" },
    { "src": "/(.*)\\.(js|mjs|css|json|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?|ttf|eot|map)$", "dest": "/$1.$2" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 2 * * *" },
    { "path": "/api/cron/sync", "schedule": "30 2 * * *" }
  ]
}