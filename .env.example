# GEMINI_API_KEY: Google AI Studio key (also used for image generation).
GEMINI_API_KEY=

# OPENCODE_API_KEY: Powers the opencode free (deepseek-v4-flash-free) and Go
# (deepseek-v4-flash) tiers. Primary model line for the whole ecosystem.
OPENCODE_API_KEY=

# DEEPSEEK_API_KEY: Direct DeepSeek API key (deepseek-v4-flash).
DEEPSEEK_API_KEY=

# OLLAMA_ENABLED: Set "1" to use the local Ollama server as a fallback tier.
OLLAMA_ENABLED=

# OPENAI_API_KEY: OpenAI API key (gpt-4o-mini).
OPENAI_API_KEY=

# ANTHROPIC_API_KEY: Anthropic API key (claude-sonnet-4-5).
ANTHROPIC_API_KEY=

# QWEN_API_KEY: Alibaba DashScope (Qwen) API key (qwen-plus).
QWEN_API_KEY=

# SPORTS_API_KEY: Used for fetching sports data
SPORTS_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PUBLIC_URL=

# PORT: Fleet dev uses 3090 so Overlay Global Lens never collides with
# Draymond's :3000 in the local fleet. Set PORT=3090 when running locally.
# PORT=3090

# SESSION_SECRET: Secret key for encrypting sensitive settings and API keys in the SQLite DB.
SESSION_SECRET=

# GOOGLE_CLIENT_ID: Your Google API Console OAuth 2.0 Client ID for Google login
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google API Console OAuth 2.0 Client Secret for Google login
GOOGLE_CLIENT_SECRET=

# ---- Overlay Global Lens — ecosystem content sources (all optional) ----

# OVERLAY_INGEST_DIR: Directory where ecosystem jobs drop JSON exports
# (research-papers.json, discovery-loop.json, hypotheses.json). Falls back to ./data/ingest
OVERLAY_INGEST_DIR=

# DRAPMOND_DIR: Path to a Draymond-Orchestrator checkout whose .draymond/*.json
# files are read directly (defaults to ../Draymond-Orchestrator).
DRAPMOND_DIR=

# DRAPMOND_URL: Optional HTTP source for research papers/discoveries/trends
# (GET {url}/api/research/papers and /api/research/discoveries).
DRAPMOND_URL=

# DRAPMOND_API_KEY: Optional Bearer token sent to DRAPMOND_URL (matches Draymond's CRON_SECRET).
DRAPMOND_API_KEY=

# COMIC_ENGINE_URL: Base URL of the Comic Metaphor Engine API
# (POST {url}/api/map). Optional; metaphors degrade gracefully when unset.
COMIC_ENGINE_URL=

# HEMPFORGE_URL / OMNIRESEARCH_URL: Optional trend insight HTTP sources.
HEMPFORGE_URL=
OMNIRESEARCH_URL=

# ONCOLOGY_URL: Base URL of the Overlay Oncology subdomain
# (GET {url}/api/calibration/state for real, cited potency + survival calibration).
# Optional; oncology findings degrade gracefully when unset.
ONCOLOGY_URL=

# OVERLAY_RESEARCH_DIR: Directory where the sports science engine writes its
# research outputs (summary_stats.json, *_sports_metrics.json). Defaults to
# ../02_Pillars/Overlay Science/research inside the ecosystem.
OVERLAY_RESEARCH_DIR=

# Overlay Oncology — transparent donations (Stripe)
# Checkout reads the raw webhook body before express.json(); /api/donate/webhook is
# mounted with express.raw() in server.ts. Public counter shows settled-only rows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DONATE_ONE_TIME=
STRIPE_PRICE_DONATE_RECURRING=


