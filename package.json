    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "motion": "^12.23.24",
    "node-cron": "^4.4.1",
    "openai": "^6.44.0",
    "p-queue": "^6.6.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.5",
    "serverless-http": "^4.0.0",
    "stripe": "^22.5.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
